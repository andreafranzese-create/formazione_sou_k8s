apiVersion: v1
kind: Pod
metadata:
  name: secret-env-pod
spec:
  containers:
  - name: app
    image: busybox:1.36
    command: ["sh", "-c", "sleep 9999"]
    env:
    - name: DB_USERNAME
      valueFrom:
        secretKeyRef:
          name: db-cred-2  
          key: username
    - name: DB_PASSWORD
      valueFrom:
        secretKeyRef:
          name: db-cred-2
          key: password