apiVersion: v1
kind: ServiceAccount
metadata:
  name: jenkins-service
  namespace: formazione-sou
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: jenkins-service-role
  namespace: formazione-sou
rules:
  - apiGroups: ["*"]      
    resources: ["*"]       
    verbs: ["*"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: jenkins-service-binding
  namespace: formazione-sou
subjects:
  - kind: ServiceAccount
    name: jenkins-service
    namespace: formazione-sou
roleRef:
  kind: Role
  name: jenkins-service-role
  apiGroup: rbac.authorization.k8s.io